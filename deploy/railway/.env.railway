# Railway Environment Variables Example
# Скопируйте эти переменные в Railway Dashboard → Variables

# Todoist API Token (дефолтный, каждый пользователь использует свой через /auth)
TODOIST_API_TOKEN=your_todoist_token_here

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Ollama - ОТКЛЮЧЁН на Railway (нет ресурсов)
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
